#!/bin/bash
# ─── dvpn-helper: the ONE root entry point of Devnet dVPN ───
# polkit action network.sentinel.devnet-dvpn.helper names exactly this file, so a desktop
# prompt can only ever run the whitelisted steps below (each a script next to this one).
# Usage: dvpn-helper <step> --Key value ...   (no shell strings, no config text)
set -euo pipefail
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
step="${1:-}"
case "$step" in
  setup-daemon|apply-daemon-config|remove-tunnels|install-deps|uninstall-cleanup|service-ctl) ;;
  *) echo "dvpn-helper: unknown step '$step'" >&2; exit 64 ;;
esac
[ "$(id -u)" = 0 ] || { echo "dvpn-helper: must run as root" >&2; exit 77; }
here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
shift
exec /bin/bash "$here/$step.sh" "$@"
